<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GoDoIncludeGuideInput Condition="'$(GoDoIncludeGuideInput)' == '' and Exists('addons/guideCS/plugin.cfg') and Exists('addons/guideCS/guide/plugin.cfg')">true</GoDoIncludeGuideInput>
    <GoDoIncludePhantomCamera Condition="'$(GoDoIncludePhantomCamera)' == '' and Exists('addons/phantom_camera/plugin.cfg')">true</GoDoIncludePhantomCamera>
    <GoDoIncludeFrifloEcs Condition="'$(GoDoIncludeFrifloEcs)' == '' and Exists('addons/godo_framework/Integrations/FrifloEcs/Runtime/EcsWorldHost.cs')">true</GoDoIncludeFrifloEcs>
  </PropertyGroup>

  <ItemGroup Condition="'$(GoDoIncludeFrifloEcs)' == 'true'">
    <PackageReference Include="Friflo.Engine.ECS" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(GoDoIncludeGuideInput)' != 'true'">
    <Compile Remove="addons/guideCS/**/*.cs" />
    <Compile Remove="addons/godo_framework/Integrations/GuideInput/**/*.cs" />
    <Compile Remove="Verification/Automated/GuideInputBackendRegression.cs" />
    <Compile Remove="Verification/Exploratory/InputLab/GuideInputLab.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(GoDoIncludePhantomCamera)' != 'true'">
    <Compile Remove="addons/phantom_camera/**/*.cs" />
    <Compile Remove="addons/godo_framework/Integrations/PhantomCamera/**/*.cs" />
    <Compile Remove="Verification/Automated/PhantomCameraRigRegression.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(GoDoIncludeFrifloEcs)' != 'true'">
    <Compile Remove="addons/godo_framework/Integrations/FrifloEcs/**/*.cs" />
    <Compile Remove="Verification/Automated/FrifloEcsRegression.cs" />
    <Compile Remove="Verification/Performance/FrifloEcsBenchmark.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(GoDoIncludeGuideInput)' != 'true' or '$(GoDoIncludePhantomCamera)' != 'true' or '$(GoDoIncludeFrifloEcs)' != 'true'">
    <Compile Remove="Demo3D/**/*.cs" />
    <Compile Remove="Verification/Automated/Demo3DFlowRegression.cs" />
    <Compile Remove="Verification/Automated/Demo3DInputProfileRegression.cs" />
    <Compile Remove="Verification/Performance/Demo3DEcsSwarmBenchmark.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'ExportRelease'">
    <Compile Remove="addons/godo_framework/Debugger/DebuggerOverlay.cs" />
  </ItemGroup>
</Project>
